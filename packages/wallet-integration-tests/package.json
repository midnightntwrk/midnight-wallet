{
  "name": "@midnight-ntwrk/wallet-integration-tests",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc -b ./tsconfig.json --noEmit --force",
    "format": "prettier --write \"**/*.{ts,js,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,yaml,yml,md}\"",
    "test": "NODE_OPTIONS='--experimental-vm-modules --experimental-specifier-resolution=node --max-old-space-size=8192' vitest run",
    "test:unit": "NODE_OPTIONS='--experimental-vm-modules --experimental-specifier-resolution=node --max-old-space-size=8192' vitest run --project unit --passWithNoTests",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules --experimental-specifier-resolution=node --max-old-space-size=8192' vitest run --project integration --passWithNoTests",
    "lint": "eslint"
  },
  "dependencies": {
    "@midnight-ntwrk/ledger-v8": "^8.1.0",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.6",
    "@midnightntwrk/wallet-sdk-abstractions": "^3.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-address-format": "^4.0.0-rc.0",
    "@midnightntwrk/wallet-sdk-capabilities": "^4.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-facade": "^5.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-hd": "^3.1.0-rc.0",
    "@midnightntwrk/wallet-sdk-prover-client": "^2.0.0-rc.0",
    "@midnightntwrk/wallet-sdk-runtime": "^2.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-shielded": "^4.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "^4.0.0-rc.1",
    "@midnightntwrk/wallet-sdk-utilities": "^1.2.2-rc.0",
    "@types/node": "^26.0.0",
    "effect": "^4.0.0",
    "pure-rand": "^8.0.0",
    "rxjs": "^7.8.2"
  }
}
