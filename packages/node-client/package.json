{
  "name": "@midnightntwrk/wallet-sdk-node-client",
  "version": "2.0.0-beta.3",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Midnight Foundation",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midnightntwrk/midnight-wallet.git",
    "directory": "packages/node-client"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect/index.d.ts",
      "import": "./dist/effect/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "dependencies": {
    "@midnightntwrk/wallet-sdk-abstractions": "3.0.0-beta.1",
    "@midnightntwrk/wallet-sdk-utilities": "1.2.2-beta.0",
    "@polkadot/api": "^16.5.4",
    "@polkadot/types": "^16.5.4",
    "@polkadot/util": "^14.0.1",
    "@types/bn.js": "^5.2.0",
    "bn.js": "^5.2.3",
    "effect": "^3.19.19"
  },
  "peerDependencies": {
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/wallet-sdk-prover-client": "2.0.0-beta.3"
  },
  "peerDependenciesMeta": {
    "@midnightntwrk/ledger-v9": {
      "optional": true
    },
    "@midnightntwrk/wallet-sdk-prover-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/cluster": "0.60.2",
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@effect/rpc": "0.76.2",
    "@effect/sql": "0.52.1",
    "@effect/workflow": "0.19.1",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/wallet-sdk-prover-client": "^2.0.0-beta.3",
    "@types/tar-stream": "3.1.4",
    "tar-stream": "3.2.0",
    "tsx": "4.23.13"
  },
  "scripts": {
    "typecheck-script": "tsc -b ./tsconfig.script.json --noEmit",
    "polkadot-typegen": "tsx ./scripts/generate-types.ts",
    "gen-test-tx": "DEBUG='testcontainers:containers' tsx ./scripts/generate-test-tx.ts",
    "typecheck": "tsc -b ./tsconfig.json --noEmit --force",
    "test": "DEBUG='testcontainers:containers' vitest run",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "DEBUG='testcontainers:containers' vitest run --project integration --passWithNoTests",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,yaml,yml,md}\"",
    "dist": "tsc -b ./tsconfig.build.json",
    "dist:publish": "tsc -b ./tsconfig.publish.json",
    "clean": "rimraf --glob dist 'tsconfig.*.tsbuildinfo' && date +%s > .clean-timestamp",
    "publint": "publint --strict"
  }
}
