{
  "name": "@midnight/wallet-serialization-tests",
  "description": "Backward-compatibility gate: restores persisted payloads written by previously published SDK versions using the current workspace code",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": "Midnight Foundation",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc -b ./tsconfig.json --noEmit --force",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,js,json,yaml,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,yaml,yml,md}\"",
    "capture": "CAPTURE_BASELINE=1 vitest run --project unit formatDrift && prettier --write \"fixtures/_baseline/**/*.json\"",
    "check:frozen": "node check-frozen.mjs"
  },
  "devDependencies": {
    "@midnight-ntwrk/ledger-v8": "^8.1.0",
    "@midnightntwrk/wallet-sdk-abstractions": "workspace:*",
    "@midnightntwrk/wallet-sdk-capabilities": "workspace:^",
    "@midnightntwrk/wallet-sdk-dust-wallet": "workspace:^",
    "@midnightntwrk/wallet-sdk-facade": "workspace:^",
    "@midnightntwrk/wallet-sdk-shielded": "workspace:^",
    "@midnightntwrk/wallet-sdk-unshielded-wallet": "workspace:^",
    "@midnightntwrk/wallet-sdk-utilities": "workspace:*",
    "@types/node": "24.13.2",
    "effect": "^3.19.19",
    "eslint": "10.6.0",
    "prettier": "3.8.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9",
    "wallet-sdk-abstractions-2.1.0": "npm:@midnightntwrk/wallet-sdk-abstractions@2.1.0"
  }
}
