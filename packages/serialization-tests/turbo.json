{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "test/**/*.{ts,tsx}",
        "fixtures/**/*.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "vitest.config.ts"
      ],
      "dependsOn": ["^dist", "typecheck"]
    },
    "test:unit": {
      "inputs": [
        "test/**/*.{ts,tsx}",
        "fixtures/**/*.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "vitest.config.ts"
      ],
      "dependsOn": ["^dist", "typecheck"]
    },
    "capture": {
      "inputs": [
        "test/**/*.{ts,tsx}",
        "fixtures/**/*.json",
        "tsconfig*.json",
        "$TURBO_ROOT$/tsconfig.base.json",
        "vitest.config.ts"
      ],
      "dependsOn": ["^dist"],
      "cache": false
    }
  }
}
